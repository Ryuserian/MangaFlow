<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MangaFlow.Core\MangaFlow.Core.csproj" />
    <ProjectReference Include="..\MangaFlow.ModelManager\MangaFlow.ModelManager.csproj" />
    <!-- rec VLM(Qwen3-VL-30B-A3B GGUF+mmproj) in-process mtmd 로더 — QwenGgufTranslateEngine과 동일 LLamaSharp 패턴 -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.30.0" />
    <!-- 백엔드 OS 분기: macOS=Cpu(+Metal 동봉) / Windows·Linux=Cuda13
         (LLamaSharp.Backend.Cuda13 메타패키지 = .Windows+.Linux 바이너리, cublas 없으면 ggml soft-fail→CPU) -->
    <PackageReference Include="LLamaSharp.Backend.Cuda13" Version="0.30.0" Condition="!$([MSBuild]::IsOSPlatform('OSX'))" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.30.0" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
  </ItemGroup>

</Project>
