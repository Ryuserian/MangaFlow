<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MangaTranslator.App.ViewModels"
        x:Class="MangaTranslator.App.Views.SplashWindow"
        x:DataType="vm:SplashViewModel"
        Title="Manga Translator"
        Width="560" Height="360"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent"
        Topmost="True">

  <!-- 라이트 테마 전환(2026-10-25): 흰 플로팅 카드+다크 잉크 텍스트. accent=브랜드 오렌지 -->
  <Border CornerRadius="14" Background="#FFFFFFFF" Padding="0"
          BorderBrush="#14000000" BorderThickness="1">
    <!-- 래퍼 Grid: ✕는 마진 없는 최상위 레이어에서 코너에 고정 -->
    <Grid>

      <Grid RowDefinitions="*,Auto" Margin="28,24,28,20">
        <!-- ===== 정상 부팅/다운로드 진행 뷰 ===== -->
        <StackPanel VerticalAlignment="Center" Spacing="6"
                    IsVisible="{Binding NeedsModels, Converter={x:Static BoolConverters.Not}}">
          <TextBlock Text="📖 Manga Translator" FontSize="30" FontWeight="Bold" Foreground="#FF1D2129"/>
          <TextBlock Text="日本語 → 한국어 · all-local pipeline" FontSize="13" Foreground="#991D2129"/>

          <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1"
                      Height="8" CornerRadius="4" Margin="0,18,0,6"
                      Foreground="#FFFF6D00" Background="#1F000000"/>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Message}" FontSize="12" Foreground="#CC1D2129"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding ElapsedText}" FontSize="12"
                       Foreground="#8C1D2129" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>

        <!-- ===== 모델 부족: 다운로드 선택 뷰 ===== -->
        <StackPanel VerticalAlignment="Center" Spacing="8"
                    IsVisible="{Binding NeedsModels}">
          <TextBlock Text="📥 모델 다운로드" FontSize="24" FontWeight="Bold" Foreground="#FF1D2129"/>
          <SelectableTextBlock Text="{Binding MissingSummary}" FontSize="11" Foreground="#991D2129"
                               TextWrapping="Wrap" MaxHeight="120"/>
          <!-- 번역 모델 택1 — 기본(첫 항목)=32B, 저사양 대안=14B -->
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0"
                      IsVisible="{Binding HasTranslateChoice}">
            <TextBlock Text="번역 모델" FontSize="12" Foreground="#CC1D2129" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding TranslateChoices}" SelectedItem="{Binding TranslateChoice}"
                      MinWidth="240" FontSize="12"/>
          </StackPanel>
          <TextBlock Text="{Binding Message}" FontSize="11" Foreground="#8C1D2129" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <Button Command="{Binding DownloadCommand}" Padding="18,9" Classes="accent"
                    Background="#FFFF6D00" Foreground="#FFFFFFFF" FontWeight="SemiBold" CornerRadius="9">
              <TextBlock Text="⬇  다운로드 (선택 번역 포함)"/>
            </Button>
            <Button Command="{Binding SkipCommand}" Padding="14,9"
                    Background="#FFF1F2F6" Foreground="#CC1D2129" CornerRadius="9">
              <TextBlock Text="번역 GGUF 제외하고 시작 (OCR/LaMa 다운로드)"/>
            </Button>
          </StackPanel>
          <!-- 다운로드 진행 표시 (버튼 누른 후) -->
          <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1" Height="8" CornerRadius="4"
                     Foreground="#FFFF6D00" Background="#1F000000"
                     IsVisible="{Binding IsDownloading}"/>
        </StackPanel>

        <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontSize="10" Foreground="#661D2129"
                   Text="무거운 모델은 처음 한 번만 로드됩니다 — 이후 세션은 즉시 시작"/>
      </Grid>

      <!-- ✕ 종료: 2026-10-26 사용자 요청 — 색 연하게(테두리 옅은 그레이, X 중염색). hover에서 빨강으로 강조 -->
      <Button Name="CancelButton"
              Command="{Binding CancelCommand}"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
              Margin="0,8,8,0" Width="28" Height="28" Padding="0"
              Background="#FFFFFFFF" BorderBrush="#26000000" BorderThickness="1"
              CornerRadius="5" Cursor="Hand"
              ToolTip.Tip="종료 (취소하고 나가기 — 남은 다운로드는 이어받기 유지)"
              PointerPressed="OnCancelPressed">
        <Button.Styles>
          <Style Selector="Button#CancelButton /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <!-- ContentPresenter 기본 패딩이 Path를 우하방으로 밀던 원인(실측) → 0 고정 -->
            <Setter Property="Padding" Value="0"/>
          </Style>
          <Style Selector="Button#CancelButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFFEF2F2"/>
            <Setter Property="BorderBrush" Value="#80D92D20"/>
          </Style>
          <!-- hover 시에만 빨강 강조(평상시는 연하게) -->
          <Style Selector="Button#CancelButton:pointerover Path">
            <Setter Property="Stroke" Value="#FFD92D20"/>
          </Style>
        </Button.Styles>
        <!-- 고정 14×14 박스 안에 대각선을 그려 정중앙 정렬을 구조적으로 보장. 평상색=연한 그레이 -->
        <Panel Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Path Stroke="#8C6B7280" StrokeThickness="2" StrokeLineCap="Round"
                Data="M 2,2 L 12,12 M 12,2 L 2,12"/>
        </Panel>
      </Button>

    </Grid>
  </Border>
</Window>
