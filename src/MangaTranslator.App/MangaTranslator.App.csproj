<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe(2026-10-26 사용자 요청): GUI 더블클릭 시 콘솔 black window 미표시.
         CLI(CLI 스모크·audit 등)는 Program.Main의 ConsoleBridge.AttachConsole 재연결로
         터미널 출력 유지(Windows GUI 앱 표준 패턴). -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- macOS 현지: .NET 8 런타임 미설치 — 설치된 최신 런타임(10.x)으로 롤폴워 실행 -->
    <RollForward>LatestMajor</RollForward>
    <!-- Release(배포)는 pdb 미생성 — 배포 폴더 정리(2026-10-26 ftg: pdb 100MB+ 삭제 후 재publish 방지) -->
    <DebugType Condition="'$(Configuration)'=='Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)'=='Release'">false</DebugSymbols>
  </PropertyGroup>

  <!-- CUDA DLL 전략(2026-10-26 단순화):
       · git: 커밋 안 함(GitHub 100MB/파일 제한) — cublas/cuDNN ~1.5GB.
       · GitHub Release v1.0.0 zip: exe+ggml-cuda+cublas+cuDNN 전체 동봉 →
         CUDA 미설치 PC에서도 PATH 없이 GPU 가속(프로세스 탐색 1순위=exe 폴더).
       · 소스 빌드(클론): CUDA Toolkit/cuDNN 설치 PC → 실행 시 PATH 자동주입으로 GPU.
         미설치 PC는 CPU 폴백(동작하나 느림). -->
  <PropertyGroup>
  </PropertyGroup>

  <!-- macOS: llama.cpp 네이티브 install_name이 @rpath/libX.0.dylib를 요구하나 패키지는 libX.dylib로 동봉 →
       osx-arm64 native 디렉터리에 .0 버전 심볼릭 자동 생성(dlopen 실패 방지, 실측 필요). -->
  <Target Name="SymlinkNativeVersions" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Exec Command="cd $(OutDir)runtimes/osx-arm64/native &amp;&amp; ln -sf libllama.dylib libllama.0.dylib &amp;&amp; ln -sf libggml.dylib libggml.0.dylib &amp;&amp; ln -sf libggml-cpu.dylib libggml-cpu.0.dylib &amp;&amp; ln -sf libggml-blas.dylib libggml-blas.0.dylib &amp;&amp; ln -sf libggml-metal.dylib libggml-metal.0.dylib &amp;&amp; ln -sf libggml-base.dylib libggml-base.0.dylib &amp;&amp; ln -sf libmtmd.dylib libmtmd.0.dylib" ContinueOnError="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <!-- ReactiveUI 라인: Avalonia 12.x는 ReactiveUI.Avalonia(구 Avalonia.ReactiveUI 대체) + ReactiveUI 26.0.1 조합.
         ReactiveUI.Avalonia 12.1.6 → Avalonia≥12.1.3, ReactiveUI 26.0.1, Splat 21. -->
    <PackageReference Include="ReactiveUI" Version="26.0.1" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.6" />
    <PackageReference Include="System.Reactive" Version="6.0.1" />
    <!-- 2.1.9 = 마지막 Apache-2.0 라인 (3.x는 Split License: Release 키 요구) . progressive JPEG 지원 동일, advisory는 신뢰 로컬파일이라 수용 -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MangaTranslator.Core\MangaTranslator.Core.csproj" />
    <ProjectReference Include="..\MangaTranslator.ModelManager\MangaTranslator.ModelManager.csproj" />
    <ProjectReference Include="..\MangaTranslator.Plugins.Ocr.PpOcr\MangaTranslator.Plugins.Ocr.PpOcr.csproj" />
    <ProjectReference Include="..\MangaTranslator.Plugins.Ocr.VlmOcr\MangaTranslator.Plugins.Ocr.VlmOcr.csproj" />
    <ProjectReference Include="..\MangaTranslator.Plugins.Ocr.VlmQwen\MangaTranslator.Plugins.Ocr.VlmQwen.csproj" />
    <ProjectReference Include="..\MangaTranslator.Plugins.Inpaint.Lama\MangaTranslator.Plugins.Inpaint.Lama.csproj" />
    <ProjectReference Include="..\MangaTranslator.Plugins.Translate.QwenGguf\MangaTranslator.Plugins.Translate.QwenGguf.csproj" />
    <ProjectReference Include="..\MangaTranslator.Plugins.Translate.WebApi\MangaTranslator.Plugins.Translate.WebApi.csproj" />
    <ProjectReference Include="..\MangaTranslator.Plugins.Render.Skia\MangaTranslator.Plugins.Render.Skia.csproj" />
  </ItemGroup>

  <!-- *.axaml은 Avalonia targets가 자동 include (수동 include 시 AVLN2002 중복) -->

  <!-- v4 네이티브 DLL 루트 스테이징: runtimes/win-x64/native/{avx2,cuda13} 하위폴더로는
       .NET 기본 네이티브 탐색이 ggml.dll의 의존 ggml-cpu.dll을 못 찾아 로드 실패(에러 126, 실측).
       avx2 = CPU 최고 ISA 전체 세트(이번 세션 검증), cuda13\ggml-cuda.dll 동거 —
       cublas 부재 시 ggml이 soft-fail 후 자동으로 CPU 백엔드 사용.

       Publish 수정(2026-10-26): publish 시 $(OutDir)은 bin\Release\...로 남아 publish 폴더에
       반영 안 됨(실측 — ftg 루트 ggml-cuda.dll 부재). publish는 별도 타깃에서 실행시점
       $(PublishDir)를 참조 → self-contained 배포판 exe 루트에도 avx2+cuda13 DLL이 오른다.
       ⚠ top-level PropertyGroup에서 OutDir/PublishDir를 미리 계산하면 빈 값(SDK targets가
       나중에 채움) → MSB3023. ItemGroup/Copy는 반드시 Target 안에서 실행시점 참조할 것. -->
  <Target Name="StageNativeToRoot" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <NativeAvx2B Include="$(OutDir)runtimes\win-x64\native\avx2\*.dll" />
      <NativeCudaB Include="$(OutDir)runtimes\win-x64\native\cuda13\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeAvx2B)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NativeCudaB)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="StageNativeToRootPublish" AfterTargets="Publish"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(PublishDir)'!=''">
    <ItemGroup>
      <NativeAvx2P Include="$(PublishDir)runtimes\win-x64\native\avx2\*.dll" />
      <NativeCudaP Include="$(PublishDir)runtimes\win-x64\native\cuda13\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeAvx2P)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NativeCudaP)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="[native-stage/publish] avx2+cuda13 DLL → $(PublishDir)" />
  </Target>

</Project>
