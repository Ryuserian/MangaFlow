<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MangaTranslator.App.App"
             RequestedThemeVariant="Light">
  <!-- 밝은 세션 베이스(2026-10-25 사용자 요청): Fluent Light + 브랜드 오렌지 토큰 -->
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
  <Application.Resources>
    <Color x:Key="BrandOrange">#FFFF6D00</Color>
    <SolidColorBrush x:Key="BrandOrangeBrush" Color="{StaticResource BrandOrange}"/>
  </Application.Resources>
</Application>
