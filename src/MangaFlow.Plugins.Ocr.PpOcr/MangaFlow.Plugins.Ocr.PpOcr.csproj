<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- GPU 기본정책: Windows·Linux=CUDA 우선(없으면 런타임 CPU 폴백), macOS=CPU(Metal은 llama.cpp 담당). ORTGpu=false 강제 CPU -->
    <ORTGpu Condition="'$(ORTGpu)' == '' And !$([MSBuild]::IsOSPlatform('OSX'))">true</ORTGpu>
    <ORTGpu Condition="'$(ORTGpu)' == ''">false</ORTGpu>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MangaFlow.Core\MangaFlow.Core.csproj" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" Condition="'$(ORTGpu)' != 'true'" />
    <!-- CUDA EP 패키지는 OS별 개별 리리스 — Gpu=Windows 전용, Linux는 *.Gpu.Linux (nuget 1.31.0 실존 확인) -->
    <!-- Gpu 메타패키지 = .Windows+.Linux 네이티브 포함(nuspec 실측) → Win·Linux 모두 CUDA, macOS는 CPU -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.31.0" Condition="'$(ORTGpu)' == 'true'" />
    <!-- det postprocess는 순수 C#(connected-components). native OpenCV 의존 없음 → Android/Desktop 동일 -->

    <!-- 모바일로 갈 때: Microsoft.ML.OnnxRuntime + XNNPACK/NNAPI delegate (Avalonia head 동일 패키지 재사용) -->
  </ItemGroup>

</Project>
