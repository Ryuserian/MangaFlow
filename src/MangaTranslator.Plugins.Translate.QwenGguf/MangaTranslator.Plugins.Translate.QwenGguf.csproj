<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MangaTranslator.Core\MangaTranslator.Core.csproj" />
    <!-- llama.cpp 공식 릴리즈 바이너리(llama-server) subprocess+HTTP. 네이티브 바인딩 불요 -->
    <ProjectReference Include="..\MangaTranslator.ModelManager\MangaTranslator.ModelManager.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ④ 번역: Qwen3 GGUF → llama.cpp in-process 바인딩. 백엔드 OS 분기:
         macOS = Cpu(+Metal 백엔드가 LLamaSharpRuntimes/osx-arm64에 동봉),
         Windows·Linux = Cuda13 — Cuda13 메타패키지는 .Windows+.Linux 바이너리 포함(nuspec 실측),
         CUDA 없는 머신은 ggml soft-fail 후 CPU 자동 폴백 -->
    <PackageReference Include="LLamaSharp" Version="0.30.0" />
    <PackageReference Include="LLamaSharp.Backend.Cuda13" Version="0.30.0" Condition="!$([MSBuild]::IsOSPlatform('OSX'))" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.30.0" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
  </ItemGroup>

</Project>
